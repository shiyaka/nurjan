{
  "name": "nurjan",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Nurjan · Vue 3 + Pinia + Hono REST API（内存存储）的轻量信息流",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "pinia": "^3.0.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.5",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^10.0.7",
    "jsdom": "^26.0.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
